# Local development defaults. Copy to .env before starting services.
DATABASE_URL="postgresql://slotsync:slotsync_dev@localhost:5432/slotsync?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=4000
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_DEMO_MODE="true"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-before-production"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret-before-production"
